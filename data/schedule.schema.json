{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "schedule.schema.json",
  "title": "Kickball season schedule",
  "description": "Games, match blocks, and field duties for a kickball season.",
  "type": "object",
  "required": ["teams", "games"],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Optional pointer to this schema file for editor validation (JSON Schema meta)."
    },
    "teams": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/definitions/teamDef" }
    },
    "games": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/game" }
    }
  },
  "definitions": {
    "teamDef": {
      "type": "object",
      "required": ["name", "emoji", "color", "pillLabelColor"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "emoji": { "type": "string" },
        "color": { "type": "string" },
        "pillLabelColor": { "type": "string" }
      }
    },
    "pitchField": {
      "type": "string",
      "enum": ["Kiosk", "Road", "Middle", "Water"],
      "description": "Pitch/field name — only these four fields are used in the schedule."
    },
    "game": {
      "type": "object",
      "required": [
        "gameNumber",
        "date",
        "title",
        "theme",
        "themeEmoji",
        "themeDescription",
        "fieldSetupTime",
        "fieldPackDownTime",
        "fieldSetupTeams",
        "fieldPackDownTeams",
        "matches",
        "postPlaySocial"
      ],
      "additionalProperties": false,
      "properties": {
        "gameNumber": {
          "type": "integer",
          "minimum": 1,
          "description": "Sequential game id within the season."
        },
        "date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "description": "Local calendar date (YYYY-MM-DD)."
        },
        "title": { "type": "string" },
        "theme": { "type": "string" },
        "themeEmoji": {
          "type": "string",
          "description": "Emoji for this game's theme (e.g. in team-view schedule cards)."
        },
        "themeDescription": { "type": "string" },
        "fieldSetupTime": {
          "description": "Display time for field setup, or null if none.",
          "type": ["string", "null"]
        },
        "fieldPackDownTime": {
          "description": "Display time for field pack down, or null if none.",
          "type": ["string", "null"]
        },
        "fieldSetupTeams": {
          "type": "array",
          "items": { "type": "string" }
        },
        "fieldPackDownTeams": {
          "type": "array",
          "items": { "type": "string" }
        },
        "matches": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/matchBlock" }
        },
        "postPlaySocial": {
          "type": "string",
          "description": "Venue or label for post-play social."
        }
      }
    },
    "matchBlock": {
      "type": "object",
      "required": ["time", "fixtures"],
      "additionalProperties": false,
      "properties": {
        "time": {
          "type": "string",
          "description": "Display time for this block (e.g. 3:00 PM)."
        },
        "fixtures": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/fixture" }
        }
      }
    },
    "fixture": {
      "description": "A matchup on a pitch (home and away team short names).",
      "type": "object",
      "required": ["field", "home", "away", "lineRefTeams"],
      "additionalProperties": false,
      "properties": {
        "field": { "$ref": "#/definitions/pitchField" },
        "home": { "type": "string" },
        "away": { "type": "string" },
        "lineRefTeams": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" },
          "description": "Teams that provide a line ref for this matchup."
        }
      }
    }
  }
}
